# Razorpay Credentials
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Server Configuration
PORT=5000

# Payment notification email (Gmail SMTP)
# EMAIL_APP_PASSWORD is a Gmail App Password, not the account password —
# generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification enabled on the account first).
NOTIFICATION_EMAIL_USER=your_gmail_address_here@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password_here
