# Razorpay Credentials
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Server Configuration
PORT=5000

# Payment/download notification email (via Resend, https://resend.com)
# RESEND_API_KEY from https://resend.com/api-keys
# NOTIFICATION_EMAIL_USER is where the notification is sent (not a sender
# login — Resend's shared sandbox address is used as the sender).
RESEND_API_KEY=your_resend_api_key_here
NOTIFICATION_EMAIL_USER=your_notification_email_here@gmail.com
